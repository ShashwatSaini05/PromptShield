# PromptShield-App backend configuration
# Copy to .env and edit as needed.

# Database (SQLite for dev; swap to postgresql://user:pass@host/db for prod)
# DATABASE_URL=sqlite:///./promptshield.db

# JWT secret - CHANGE THIS (use: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-in-production-use-a-random-256-bit-hex
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Path to the PromptShield-ML model directory
# MODEL_DIR=../../PromptShield/model

# Require JWT for /predict endpoints
REQUIRE_AUTH_FOR_PREDICT=false

# Max prompt length in characters
MAX_PROMPT_LENGTH=4000

# Rate limit: requests per minute on /predict
RATE_LIMIT_PER_MINUTE=60

# Comma-separated CORS origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
